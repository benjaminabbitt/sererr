# sererr — Python toolchain container.

FROM docker.io/library/python:3.12-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ARG JUST_VERSION=1.36.0
RUN curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
        | tar -xz -C /usr/local/bin just

# `uv` — fast Python package manager (replaces pip/poetry/pipx workflows).
ARG UV_VERSION=0.4.30
RUN curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz --strip-components=1 -C /usr/local/bin uv-x86_64-unknown-linux-gnu/uv

# `mutmut` — Python mutation testing.
RUN pip install --no-cache-dir mutmut

WORKDIR /workspace
