# sererr — TypeScript / JavaScript toolchain container.

FROM docker.io/library/node:20-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ARG JUST_VERSION=1.36.0
RUN curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
        | tar -xz -C /usr/local/bin just

# buf — proto module management (used by @bufbuild/protoc-gen-es).
ARG BUF_VERSION=1.45.0
RUN curl -fsSL "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/buf-Linux-x86_64" \
        -o /usr/local/bin/buf && chmod +x /usr/local/bin/buf

# `@stryker-mutator/core` — JS/TS mutation testing.
# Installed per-project as a devDependency rather than globally so the
# version matches the project's package.json. No system install here.

WORKDIR /workspace
