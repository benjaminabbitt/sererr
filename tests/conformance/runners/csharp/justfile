# C# conformance runner — invoked by tests/conformance/run.sh, or
# directly via `just test`.

set shell := ["bash", "-c"]

TOP := `git rev-parse --show-toplevel`

default:
    @just --list

# Run the Reqnroll suite. Features and fixtures resolved via env vars.
test: _copy-features
    SERERR_FEATURES_DIR={{TOP}}/tests/conformance/features \
    SERERR_FIXTURES_DIR={{TOP}}/tests/conformance/fixtures \
    dotnet test

build: _copy-features
    dotnet build

# Reqnroll's MSBuild glob evaluates at project-parse time, BEFORE any
# target runs, so we can't copy the shared corpus in via an MSBuild
# target on a clean build — we'd need two passes. Copy the .feature
# files in via just before the build instead. Idempotent; safe to
# re-run.
_copy-features:
    mkdir -p Features
    cp -u {{TOP}}/tests/conformance/features/*.feature Features/
