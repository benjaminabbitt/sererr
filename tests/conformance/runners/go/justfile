# Go conformance runner — invoked by tests/conformance/run.sh, or
# directly via `just test`.

set shell := ["bash", "-c"]

TOP := `git rev-parse --show-toplevel`

default:
    @just --list

# Run the godog suite. Features and fixtures resolved via env vars.
test:
    SERERR_FEATURES_DIR={{TOP}}/tests/conformance/features \
    SERERR_FIXTURES_DIR={{TOP}}/tests/conformance/fixtures \
    go test ./...

build:
    go build ./...
