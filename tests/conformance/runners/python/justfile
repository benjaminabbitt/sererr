# Python conformance runner — invoked by tests/conformance/run.sh, or
# directly via `just test`.
#
# Steps live at features/steps/ inside this directory; features are
# resolved from the shared corpus via SERERR_FEATURES_DIR. The two are
# bridged by main.py, which subclasses behave's Runner to allow the
# features-path and the steps-path to live in different subtrees.

set shell := ["bash", "-c"]

TOP := `git rev-parse --show-toplevel`

default:
    @just --list

test:
    SERERR_FEATURES_DIR={{TOP}}/tests/conformance/features \
    SERERR_FIXTURES_DIR={{TOP}}/tests/conformance/fixtures \
    uv run --project . python main.py --no-source --tags=~@wip

build:
    uv sync --project .
